DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_SECRET=replace-with-at-least-32-characters
OTP_TTL_SECONDS=300
OTP_LOG_IN_CONSOLE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Optional: Google OAuth login (not wired until client/server callback setup is completed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
VITE_GOOGLE_CLIENT_ID=

# Optional: WhatsApp Cloud API (fallback wa.me link works without these)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v19.0

# Set these for PostgreSQL. If POSTGRES_DB is empty, sqlite fallback is used.
POSTGRES_DB=billing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache backend
# Use CACHE_BACKEND=redis in production for faster server-side caching.
# Keep locmem for local/dev if Redis is not running.
CACHE_BACKEND=locmem
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=billing
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_IGNORE_EXCEPTIONS=true
